{
  "name": "universal-react-dropdown",
  "version": "1.1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightness/universal-react-dropdown"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-css",
    "copy-css": "rsync -a --prune-empty-dirs --include '*/' --include '*.css' --exclude '*' src/ dist/",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "registry:build": "shadcn build"
  },
  "keywords": [
    "react",
    "dropdown",
    "component",
    "select",
    "typescript"
  ],
  "author": "nightness",
  "company": "Brainwires",
  "license": "MIT",
  "description": "A customizable React Dropdown component designed for flexible integration into React applications.",
  "peerDependencies": {
    "react": "^18.0.0 || >=19.0.4 <19.1.0 || >=19.1.5 <19.2.0 || >=19.2.4 <20.0.0",
    "react-dom": "^18.0.0 || >=19.0.4 <19.1.0 || >=19.1.5 <19.2.0 || >=19.2.4 <20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-react": "^7.35.0",
    "shadcn": "^3.8.5",
    "typescript": "^5.5.4"
  }
}
